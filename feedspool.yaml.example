# feedspool Configuration File Example

# Database file path
database: ./feeds.db

# Timeout for individual feed fetches (shared by fetch and unfurl)
timeout: 30s

# Verbose output
verbose: false

# Debug output
debug: false

# JSON output format
json: false

# Default feed list settings
feedlist:
  format: ""    # Default format for feed lists (opml or text)
  filename: ""  # Default filename for feed lists
  dir: ""       # Directory of OPML/text feed lists; builds one site per file
                # plus a top-level index. Mutually exclusive with filename.

# Fetch settings
fetch:
  with_unfurl: false    # Run unfurl operations in parallel with feed fetching
  concurrency: 32       # Maximum concurrent feed fetches
  max_items: 100        # Maximum number of items to keep per feed

# Build pipeline settings (for 'build' command)
build:
  skip_embed: false     # Set to true to skip vector embedding step during build
  skip_topics: false    # Set to true to skip topic generation step during build

# Static site generator settings
render:
  output_dir: "./build"                 # Default output directory for rendered site
  templates_dir: ""                     # Custom templates directory (empty = use embedded)
  assets_dir: ""                        # Custom assets directory (empty = use embedded)
  default_max_age: "24h"                # Default time window for rendering
  default_clean: false                  # Default behavior for cleaning output directory before building
  default_min_items_per_feed: 5         # Minimum items to show per feed regardless of age
  default_max_items_per_feed: 50        # Maximum items to show per feed (0 = no limit)
  feeds_per_page: 25                    # Feeds per page for pagination (0 = disable pagination)
  topic_max_feed_ratio: 0.8             # Max ratio of items from one feed before topic is rejected
  topic_min_diversity_count: 2          # Min items in a topic before applying diversity limits

# Vector embedding settings (for 'embed' command)
embed:
  base_url: "http://localhost:11434" # Provider URL (Ollama or OpenAI/LiteLLM /v1 endpoint)
  model: "nomic-embed-text"          # Embedding model name
  default_last: "1w"                 # Default time window for embedding items
  batch_size: 0                      # Items per provider request (0 = model default)
  num_ctx: 0                         # Context window size (0 = model default)
  # Bearer token required for remote provider. Leave empty for local Ollama.
  # Prefer the FEEDSPOOL_EMBED_API_KEY environment variable over writing it here.
  api_key: ""

# Trending topics settings (for 'topics' command)
topics:
  base_url: "http://localhost:11434" # Provider URL for LLM labeling (Ollama or OpenAI/LiteLLM /v1 endpoint)
  model: "qwen2.5:7b"               # LLM model name for topic cluster labeling
  embed_model: ""                    # Override embedding model used for topic clustering (empty = embed.model)
  default_last: "1d"                 # Default time window for topic generation
  threshold: 0.70                    # Cosine similarity threshold for clustering
  min_items: 7                       # Minimum items in a cluster required to keep and label it
  max_items: 100                     # Maximum items allowed in a cluster before dropping (0 = no limit)
  concurrency: 5                     # Concurrent LLM requests when generating labels
  lineage_lookback: 6                # Previous runs searched for the same topic
  lineage_threshold: 0.5             # Item-set Jaccard at/above which a cluster joins an existing thread
  inherit_threshold: 0.9             # Jaccard at/above which it also keeps the thread's label (no LLM call)
  growth_margin: 2                   # Items gained/lost in 24h (vs the 24h before) to count as growing/fading
  # Bearer token for remote provider.
  api_key: ""

# HTTP server settings
serve:
  port: 8889        # Default HTTP server port
  bind: ""          # Listen address; "" is all interfaces, "127.0.0.1" is this machine only
  dir: "./build"    # Default directory to serve
  api:
    enabled: false  # Mount the JSON API at /api/v1/
    # Bearer token required on every API request. Leave empty to disable auth.
    # Prefer the FEEDSPOOL_API_TOKEN environment variable over writing it here.
    # There is no --api-token flag on purpose: a token passed on the command
    # line shows up in ps output.
    token: ""

# Purge settings
purge:
  max_age: "30d"    # Default time window for purging old items and topic runs
  min_items: 10     # Minimum items to keep per feed when purging old items

# Initialization settings
init:
  templates_dir: "./templates"  # Default directory for template extraction
  assets_dir: "./assets"        # Default directory for asset extraction

# Unfurl settings  
unfurl:
  skip_robots: false    # Skip robots.txt checking when fetching URLs for metadata
  retry_after: "1h"     # Retry failed fetches after this duration  
  concurrency: 32       # Maximum concurrent fetches for unfurl operations
